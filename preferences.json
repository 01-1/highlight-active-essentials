[
  { "type": "separator", "label": "Loaded tabs" },
  {
    "property": "mod.tab-state-highlighter.loaded.effect",
    "label": "Effect",
    "type": "dropdown",
    "defaultValue": "ring",
    "placeholder": false,
    "options": [
      { "label": "Ring around the tab", "value": "ring" },
      { "label": "Glow around the whole tab", "value": "tab-glow" },
      { "label": "Glow behind the favicon", "value": "glow" },
      { "label": "Dot in the corner", "value": "dot" },
      { "label": "Ring and dot", "value": "ring-dot" },
      { "label": "Off", "value": "off" }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.color",
    "label": "Color",
    "type": "dropdown",
    "defaultValue": "accent",
    "placeholder": false,
    "options": [
      { "label": "Zen accent color", "value": "accent" },
      { "label": "Custom", "value": "custom" }
    ],
    "conditions": [
      { "not": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "off" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.custom-color",
    "label": "Custom color (any CSS color; leave the field to save)",
    "type": "string",
    "defaultValue": "#3ddc84",
    "placeholder": "e.g. #3ddc84, rgb(61 220 132), lime",
    "border": "value",
    "operator": "AND",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.loaded.color", "value": "custom" } },
      { "not": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "off" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.ring-width",
    "label": "Ring width (px; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 2,
    "placeholder": "2",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "ring" } },
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "ring-dot" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.glow-strength",
    "label": "Glow strength (number with no maximum; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 100,
    "placeholder": "100",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "tab-glow" } },
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "glow" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.dot-size",
    "label": "Dot size (px; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 5,
    "placeholder": "5",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "dot" } },
      { "if": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "ring-dot" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.loaded.hide-on-selected",
    "label": "Hide the effect on the selected loaded tab",
    "type": "checkbox",
    "defaultValue": false,
    "conditions": [
      { "not": { "property": "mod.tab-state-highlighter.loaded.effect", "value": "off" } }
    ]
  },

  { "type": "separator", "label": "Unloaded tabs" },
  {
    "property": "mod.tab-state-highlighter.unloaded.effect",
    "label": "Effect",
    "type": "dropdown",
    "defaultValue": "off",
    "placeholder": false,
    "options": [
      { "label": "Same as loaded tabs", "value": "same" },
      { "label": "Ring around the tab", "value": "ring" },
      { "label": "Glow around the whole tab", "value": "tab-glow" },
      { "label": "Glow behind the favicon", "value": "glow" },
      { "label": "Dot in the corner", "value": "dot" },
      { "label": "Ring and dot", "value": "ring-dot" },
      { "label": "Off", "value": "off" }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.color",
    "label": "Color",
    "type": "dropdown",
    "defaultValue": "same",
    "placeholder": false,
    "options": [
      { "label": "Same as loaded tabs", "value": "same" },
      { "label": "Zen accent color", "value": "accent" },
      { "label": "Custom", "value": "custom" }
    ],
    "operator": "AND",
    "conditions": [
      { "not": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "same" } },
      { "not": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "off" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.custom-color",
    "label": "Custom color (any CSS color; leave the field to save)",
    "type": "string",
    "defaultValue": "#ff8a3d",
    "placeholder": "e.g. #ff8a3d, rgb(255 138 61), orange",
    "border": "value",
    "operator": "AND",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.color", "value": "custom" } },
      { "not": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "same" } },
      { "not": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "off" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.ring-width",
    "label": "Ring width (px; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 2,
    "placeholder": "2",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "ring" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "ring-dot" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.glow-strength",
    "label": "Glow strength (number with no maximum; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 100,
    "placeholder": "100",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "tab-glow" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "glow" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.dot-size",
    "label": "Dot size (px; leave the field to save)",
    "type": "string",
    "value": "num",
    "defaultValue": 5,
    "placeholder": "5",
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "dot" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "ring-dot" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.hide-on-selected",
    "label": "Hide the effect on the selected unloaded tab",
    "type": "checkbox",
    "defaultValue": false,
    "conditions": [
      { "not": { "property": "mod.tab-state-highlighter.unloaded.effect", "value": "off" } }
    ]
  },

  { "type": "separator", "label": "Unloaded tab fading" },
  {
    "property": "mod.tab-state-highlighter.unloaded.appearance",
    "label": "Appearance",
    "type": "dropdown",
    "defaultValue": "dim",
    "placeholder": false,
    "options": [
      { "label": "Dim", "value": "dim" },
      { "label": "Dim and grayscale", "value": "dim-grayscale" },
      { "label": "Grayscale only", "value": "grayscale" },
      { "label": "Browser default (mod does nothing)", "value": "browser" },
      { "label": "Never dim (always full color)", "value": "never" }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.target",
    "label": "Apply fading to",
    "type": "dropdown",
    "defaultValue": "icon",
    "placeholder": false,
    "options": [
      { "label": "Favicon only", "value": "icon" },
      { "label": "The whole tab, background included", "value": "tab" }
    ],
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim-grayscale" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "grayscale" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.opacity",
    "label": "Dim amount",
    "type": "dropdown",
    "defaultValue": "medium",
    "placeholder": false,
    "options": [
      { "label": "Light (70% opacity)", "value": "light" },
      { "label": "Medium (45% opacity)", "value": "medium" },
      { "label": "Heavy (25% opacity)", "value": "heavy" }
    ],
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim-grayscale" } }
    ]
  },
  {
    "property": "mod.tab-state-highlighter.unloaded.scope",
    "label": "Which unloaded tabs",
    "type": "dropdown",
    "defaultValue": "all",
    "placeholder": false,
    "options": [
      { "label": "All unloaded", "value": "all" },
      { "label": "Only tabs unloaded with \"Unload Tab\"", "value": "explicit" }
    ],
    "conditions": [
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "dim-grayscale" } },
      { "if": { "property": "mod.tab-state-highlighter.unloaded.appearance", "value": "grayscale" } }
    ]
  }
]
